{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodexGauge",
  "version": "../package.json",
  "identifier": "com.codexgauge.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
  },
  "app": {
    "windows": [
      {
        "title": "CodexGauge",
        "width": 700,
        "height": 620,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "rfw"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzMkU4REU0RDQ2QjFBNUUKUldSZUdtdlU1STB1MHllcUt6ZmNMWkhSUi9sYlhFdFNUcTRuSTdoTDNlOUxUQzFNdExUZ3VMY28K",
      "endpoints": [
        "https://github.com/rfw/codex-gauge/releases/latest/download/latest.json"
      ]
    }
  }
}
